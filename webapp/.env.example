# Copy to webapp/.env. Without a key the app still runs; AI doors say they are off.
ANTHROPIC_API_KEY=
# Models are pinned by the app: Haiku 5.5 cheap, Sonnet 5.5 Assistant, Opus 5.5 heavy.
# Old AI_MODEL_CHEAP / AI_MODEL_STRONG settings are ignored; no model override is needed.
PORT=8787

# Sign-in (webapp/README.md explains each)
# AUTH=off                      # no sign-in, and the AI proxy answers anyone: only for a server nobody else can reach
# APP_ORIGIN=https://your.domain # every address the app is opened at, comma-separated
# EMAIL_MODE=log                # local-only code logging; off disables; resend sends real mail
# RESEND_API_KEY=               # sending-only key; never commit real values
# EMAIL_FROM=Hodos <no-reply@hodos.consulting> # requires a verified Resend domain
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AI_HOURLY_LIMIT=30
# TRUST_PROXY=1                 # on the VM, behind the reverse proxy
# DATA_DIR=                     # where accounts.db lives; default webapp/data
