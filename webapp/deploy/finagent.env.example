# Copy to /etc/finagent/env on the VM, owned by root, mode 600. Values are typed on the VM.
# Never commit real values. design/2026-09-20-vm.md step 6.

# Fixed settings
NODE_ENV=production
HOST=127.0.0.1
PORT=8787
TRUST_PROXY=1
DATA_DIR=/var/lib/finagent
APP_ORIGIN=https://app.hodos.consulting

# Passkeys are pinned to the parent domain, so the app can move to hodos.consulting
# later without breaking every passkey. Decision 94; never change once real passkeys exist.
RP_ID=hodos.consulting

# Secrets: filled in on the VM, never here.
ANTHROPIC_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend login mail. Deploy the sender code before enabling. off keeps Google/passkeys working.
# log is refused in production; resend requires a sending-only API key and verified domain.
EMAIL_MODE=off
RESEND_API_KEY=
EMAIL_FROM="Hodos <no-reply@hodos.consulting>"
